# medic.env.example — template for pi-deploy/medic.env
#
# Copy this to medic.env and edit as needed:
#   cp medic.env.example medic.env
# install.sh does this automatically the first time it runs (and never
# touches medic.env again once it exists, so your edits are safe to
# re-run install.sh over).
#
# Every MEDIC_* variable below is read by pi-deploy/medic/common.py's
# load_config() — see that file's DEFAULTS dict, it is the source of
# truth, not this comment. Precedence is: command-line flag > this env
# var > built-in default. Leaving a line blank or deleting it falls back
# to the built-in default shown after each comment.
#
# systemd loads this file directly via EnvironmentFile= in each
# systemd/medic-*.service unit, and scripts/run_all.sh sources it into
# each tmux pane — so this ONE file is the single place to change config
# for every process, on the bench or in production.

# Which robot this physical device is. The dashboard's fleet view keys
# off this and the wire protocol (docs/http-api-v1.md) carries it on
# every request — the fleet view renders N robots, never hardcodes 1.
# If you ever clone this bundle onto a second robot (stretch goal #1 in
# docs/design-doc-v0.3.md), the ONE thing you must change is this value.
# Default: medic-01
MEDIC_ROBOT_ID=medic-01

# Where the dashboard REST API lives (docs/http-api-v1.md). This build
# runs the dashboard ON the Pi itself, so the default is the Pi's own
# loopback address — every Pi script talks to itself over localhost.
# Only point this at another machine's address if you deliberately split
# the dashboard off, and only over OUR OWN hotspot/router — never venue
# Wi-Fi, never a public address (ARCHITECTURE.md invariant §0.7).
# Default: http://127.0.0.1:5000
MEDIC_CENTRAL_URL=http://127.0.0.1:5000

# Serial port to the ESP32. "auto" scans /dev/serial/by-id/* first (a
# stable path that survives reboots and re-plugs), then falls back to
# /dev/ttyUSB*/ttyACM* (see medic/common.py find_serial_port()). Once you
# know the exact by-id path, pin it here instead of relying on autodetect.
#
# NOTE: the ESP32 is not wired up yet on this build. "auto" finding
# nothing is a SUPPORTED, expected state — every process logs it once and
# keeps retrying in the background rather than crashing or blocking.
# Default: auto
MEDIC_SERIAL_PORT=auto

# Must match firmware/src/config.h and docs/serial-protocol-v1.md exactly
# — this is frozen, do not change it per-robot.
# Default: 115200
MEDIC_SERIAL_BAUD=115200

# Seconds to wait for one dashboard HTTP call before giving up. Every
# Central() call in medic/common.py swallows the timeout and returns a
# safe/refusing default — it never raises out of the caller and never
# unlocks anything on a timeout (the fail-closed contract, ARCHITECTURE.md
# invariant §0.4).
# Default: 2.0
MEDIC_HTTP_TIMEOUT=2.0

# How often task_bridge.py polls the dashboard for the active task and
# the teleop queue, in seconds. Matches design-doc-v0.3.md §4 (500 ms).
# Default: 0.5
MEDIC_POLL_INTERVAL=0.5

# How often the Pi sends a heartbeat frame to the MCU, in seconds. The
# MCU declares SAFEHOLD_COMMS after 2 s of silence (serial-protocol-v1.md)
# — keep this comfortably below that; don't raise it without re-checking
# the 2 s budget on the firmware side too.
# Default: 0.75
MEDIC_HEARTBEAT_INTERVAL=0.75

# Python logging level for all three Pi processes: DEBUG, INFO, WARNING,
# ERROR. Use DEBUG on the bench when chasing a bug; switch back to INFO
# before the R11 45-minute endurance run — DEBUG is noisy and can shift
# timing on a Pi that is already doing camera + audio + serial work.
# Default: INFO
MEDIC_LOG_LEVEL=INFO
